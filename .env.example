# Optional: legacy fallback for contact API during migration
# Leave disabled after /api/contact is validated in production.
REACT_APP_ENABLE_LEGACY_EMAIL_FALLBACK=false
REACT_APP_LEGACY_EMAIL_API_URL=https://maieuticarh.com.br:9200/postmsg

# Contact encoding must match the server parser verified manually.
# Valid values: json or urlencoded
REACT_APP_CONTACT_ENCODING=urlencoded

# Development-only proxy URL without embedded secrets.
REACT_APP_ABLER_PROXY_URL=http://localhost:3001/v1
